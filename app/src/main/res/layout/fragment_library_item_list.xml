<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0302"
    tools:context=".fragments.LibraryFilesFragment">

    <!-- App bar (MaterialToolbar recommended) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarLibraryItemList"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navigationContentDescription="@string/back"
        app:contentInsetStart="50dp"
        app:title="Library"
        app:titleMarginStart="16dp"
        app:titleTextColor="@android:color/white"
        app:titleTextAppearance="@style/TextAppearance.AppCompat.Medium" />

    <!-- Back button placed inside toolbar area --> <ImageButton
    android:id="@+id/btnBack"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_marginStart="8dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:contentDescription="Back"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="@id/toolbarLibraryItemList"
    app:layout_constraintBottom_toBottomOf="@id/toolbarLibraryItemList" />

    <!-- Top section with background images -->
    <FrameLayout
        android:id="@+id/top_image_container"
        android:layout_width="0dp"
        android:layout_height="240dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarLibraryItemList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Base background image (fills the frame) -->
        <ImageView
            android:id="@+id/background_image_base"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/vector271"
            android:contentDescription="Background image" />

        <!-- Overlaid rounded image (centered with side padding) -->
        <ImageView
            android:id="@+id/background_image_overlay"
            android:layout_width="match_parent"
            android:layout_height="107dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerCrop"
            android:src="@drawable/vector272"
            android:contentDescription="Overlay image" />

    </FrameLayout>

    <!-- RecyclerView: responsive, fills remaining space -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewLibraryItemList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/rectangle9"
        android:paddingTop="20dp"
        android:paddingBottom="96dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:clipToPadding="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/top_image_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_library_file" />

    <!-- Floating Action Button anchored to bottom-end -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/add_file"
        app:backgroundTint="#FFCC00"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_add"
        app:tint="@android:color/black" />

</androidx.constraintlayout.widget.ConstraintLayout>
