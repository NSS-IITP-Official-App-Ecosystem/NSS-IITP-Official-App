<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/black"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/black"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:id="@+id/deleteDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_updates_to_delete"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:paddingBottom="8dp"
            android:letterSpacing="0.01" />

        <!-- Select All / Deselect All -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectAllButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_all"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:icon="@android:drawable/checkbox_on_background"
            app:iconTint="@color/white"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_gravity="end" />

        <!-- Scrollable list of updates with checkboxes -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="400dp"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/updatesListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />
        </androidx.core.widget.NestedScrollView>

        <!-- Selected count -->
        <TextView
            android:id="@+id/selectedCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 selected"
            android:textSize="14sp"
            android:textColor="#B3FFFFFF"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:gravity="center" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelDeleteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/cancel"
                android:textColor="#B3FFFFFF"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteSelectedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_selected"
                android:textColor="@color/white"
                app:backgroundTint="#FF5252"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/white"
                style="@style/Widget.MaterialComponents.Button" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
